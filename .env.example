BACKEND_PORT=9000
ADMIN_PORT=3336

# JWT (RS256 access tokens) — see README for the generation snippet
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=

# bunny
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_CDN_ZONE=
BUNNY_STORAGE_CDN_PRIVATE_KEY=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_ONLY_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_ZONE=
BUNNY_STREAM_CDN_PRIVATE_KEY=

# ngrok — tunnel for the Bunny Stream webhook; leave empty to skip it
NGROK_AUTHTOKEN=
# The account's static domain, without scheme: xxx.ngrok-free.app
NGROK_DOMAIN=
# Where the tunnel points; the default is backend.storage's PORT running on the host
# NGROK_UPSTREAM=host.docker.internal:9002
