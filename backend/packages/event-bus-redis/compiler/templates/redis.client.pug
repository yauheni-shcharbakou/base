|
|class RedisClientImpl {
|   constructor(protected readonly client: RedisQueueClient) {}
|}
|
each service in data.services
    |
    |class Redis#{pascalCase(service.eventBusName)}ClientImpl extends RedisClientImpl implements #{service.eventBusName} {
    |   constructor(protected readonly client: RedisQueueClient) {
    |       super(client);
    |   }
    |
    each method in service.methods
        |
        |   #{method.emitterName}(event: #{method.type}): Promise<any> {
        |       return this.client.emit('#{method.eventId}', event);
        |   }
        |
        |   #{method.emitterManyName}(events: #{method.type}[]): Promise<any[]> {
        |       return this.client.emitMany('#{method.eventId}', events);
        |   }
        |
    |}
    |
|
|export class RedisClientFactory {
|   private static clientsMap = new Map<Abstract<EventBus>, Type>([
|
each service in data.services
    |     [#{service.eventBusName}, Redis#{pascalCase(service.eventBusName)}ClientImpl],
    |
|   ]);
|
|   static create(client: RedisQueueClient, EventBusClass: Abstract<EventBus>): Type {
|       const Client = this.clientsMap.get(EventBusClass);
|
|       if (!Client) {
|           throw new Error(`Redis client for ${EventBusClass} not found`);
|       }
|
|       return new Client(client);
|   }
|}
|
