PORT=9000
NODE_ENV=development

# gRPC
PROTOC_PATH=protoc
API_GATEWAY_GRPC_URL=0.0.0.0:8000
AUTH_GRPC_URL=0.0.0.0:8001
STORAGE_GRPC_URL=0.0.0.0:8002

# redis (@backend/cache — the rate-limit counters)
# The throttler counts in Redis so replicas share one limit. When it is unreachable the gateway
# keeps serving and counts in-process instead. Optional CACHE_* overrides as in backend.auth.
REDIS_URL=redis://localhost:6379
# 0 = dual stack, 4 = IPv4 only, 6 = IPv6 only.
REDIS_IP_FAMILY=0
# `memory` counts in-process only (no connection at all): dev and tests.
CACHE_DRIVER=redis

# JWT
# Public half of the RS256 pair issued by backend.auth — used to verify access tokens locally.
JWT_ACCESS_PUBLIC_KEY_BASE64=
