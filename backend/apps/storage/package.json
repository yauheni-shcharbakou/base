{
  "name": "backend.storage",
  "private": true,
  "author": "Yauheni Shcharbakou <iipekolict@gmail.com>",
  "license": "MIT",
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm start:dev",
    "prod": "pnpm start:prod",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" --config ../../../.prettierrc",
    "start": "dotenv -- nest start",
    "start:dev": "dotenv -- nest start --watch service",
    "start:debug": "dotenv -- nest start --debug --watch service",
    "start:prod": "node dist/migrator/main -- pg-migration && node dist/main",
    "migrate": "dotenv -- nest start migrator -- pg-migration",
    "migrate:new": "dotenv -- nest start migrator -- pg-migration --new",
    "migrate:initial": "dotenv -- nest start migrator -- pg-migration --initial",
    "migrate:sql": "dotenv -- nest start migrator -- pg-migration --up",
    "migrate:tasks": "dotenv -- nest start migrator -- pg-migration --tasks",
    "storage:copy-zone": "dotenv -e scripts/.env.migration -- tsx scripts/copy-storage-zone.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "reset": "rm -rf .turbo dist node_modules",
    "reset:modules": "rm -rf node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@backend/common": "workspace:*",
    "@backend/event-bus": "workspace:*",
    "@backend/event-bus-redis": "workspace:*",
    "@backend/grpc": "workspace:*",
    "@backend/pg": "workspace:*",
    "@backend/proto": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/decorators": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/nestjs": "catalog:",
    "@mikro-orm/postgresql": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@packages/common": "workspace:*",
    "@packages/proto": "workspace:*",
    "@sweet-monads/either": "catalog:",
    "axios": "catalog:",
    "lodash": "catalog:",
    "moment": "catalog:",
    "nest-commander": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@packages/configs": "workspace:*",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
