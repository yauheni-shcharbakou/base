# HTTP listener for the Bunny Stream webhook — must differ from STORAGE_GRPC_URL's port.
PORT=9002
NODE_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432

# gRPC
PROTOC_PATH=protoc
AUTH_GRPC_URL=0.0.0.0:8001
STORAGE_GRPC_URL=0.0.0.0:8002

# redis (event bus)
REDIS_URL=redis://localhost:6379
# 0 = dual stack, 4 = IPv4 only, 6 = IPv6 only. Keep 0 on IPv6-only private networks (Railway).
REDIS_IP_FAMILY=0
# Everything below is optional — the values shown are the defaults @backend/event-bus-redis falls back to.
# BullMQ key prefix and the namespace of the bus' own keys (subscription sets, parking lists).
# Override both to run a second stack against one Redis without the two seeing each other.
REDIS_QUEUE_PREFIX=bull
REDIS_EVENT_BUS_NAMESPACE=event-bus
# Jobs one worker handles at once. 1 keeps delivery within a queue ordered.
REDIS_WORKER_CONCURRENCY=1
# Redelivery ladder before a job lands in the `failed` set (the DLQ): exponential backoff from
# REDIS_JOB_BACKOFF_DELAY ms.
REDIS_JOB_ATTEMPTS=10
REDIS_JOB_BACKOFF_DELAY=1000
# Events emitted before anyone had subscribed are parked here and replayed on a consumer's
# first-ever registration. Length 0 disables parking, TTL is in seconds.
REDIS_PARKING_MAX_LENGTH=1000
REDIS_PARKING_TTL=86400

# bunny
# The S3-enabled storage zone: name = bucket = S3 access key id, password = BUNNY_STORAGE_API_KEY.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
# The zone's S3 region: de, ny, uk, se, sg, la, jh or syd.
BUNNY_STORAGE_S3_REGION=de
# How long a pre-signed PUT URL stays valid. A batch signs every file up front, so the last one
# of a large batch starts late. Bunny accepts up to 7 days (10080).
BUNNY_STORAGE_UPLOAD_EXPIRES_IN_MINUTES=60
# The pull zone in front of the storage zone — `{name}.b-cdn.net`. Not the storage zone's name.
BUNNY_STORAGE_CDN_ZONE=
BUNNY_STORAGE_CDN_PRIVATE_KEY=
BUNNY_STORAGE_CDN_EXPIRES_IN_MINUTES=10
BUNNY_STREAM_API_KEY=
# The library's read-only key — Bunny signs the status webhook with it, and the guard rejects a
# callback it cannot verify. Not interchangeable with BUNNY_STREAM_API_KEY.
BUNNY_STREAM_READ_ONLY_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_ZONE=
BUNNY_STREAM_CDN_PRIVATE_KEY=
BUNNY_STREAM_CDN_EXPIRES_IN_MINUTES=60
# How long one pre-signed TUS signature stays valid. Bunny refuses anything under 60.
BUNNY_STREAM_TUS_EXPIRES_IN_MINUTES=120

# storage
# How long a PENDING/FAILED file row survives before the cleanup cron drops it. Must outlast the
# TUS window plus Bunny's encoding queue — a video only turns READY once the webhook arrives.
STORAGE_PENDING_FILE_TTL_HOURS=24
