# Env for `pnpm storage:copy-zone` — copy to `scripts/.env.migration` (git-ignored) and fill in.

# The old zone, read over the HTTP storage API. Endpoint is the zone's primary region:
# https://storage.bunnycdn.com (Falkenstein) or https://{region}.storage.bunnycdn.com.
SOURCE_ZONE=
SOURCE_API_KEY=
SOURCE_ENDPOINT=https://storage.bunnycdn.com

# The new S3-enabled zone. Access key id = zone name, secret = zone password.
TARGET_ZONE=
TARGET_API_KEY=
TARGET_REGION=de
