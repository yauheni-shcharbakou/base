PORT=9001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432

# gRPC
PROTOC_PATH=protoc
AUTH_GRPC_URL=0.0.0.0:8001

# redis (event bus)
REDIS_URL=redis://localhost:6379
# 0 = dual stack, 4 = IPv4 only, 6 = IPv6 only. Keep 0 on IPv6-only private networks (Railway).
REDIS_IP_FAMILY=0
# Everything below is optional — the values shown are the defaults @backend/event-bus-redis falls back to.
# BullMQ key prefix and the namespace of the bus' own keys (subscription sets, parking lists).
# Override both to run a second stack against one Redis without the two seeing each other.
REDIS_QUEUE_PREFIX=bull
REDIS_EVENT_BUS_NAMESPACE=event-bus
# Jobs one worker handles at once. 1 keeps delivery within a queue ordered.
REDIS_WORKER_CONCURRENCY=1
# Redelivery ladder before a job lands in the `failed` set (the DLQ): exponential backoff from
# REDIS_JOB_BACKOFF_DELAY ms.
REDIS_JOB_ATTEMPTS=10
REDIS_JOB_BACKOFF_DELAY=1000
# Events emitted before anyone had subscribed are parked here and replayed on a consumer's
# first-ever registration. Length 0 disables parking, TTL is in seconds.
REDIS_PARKING_MAX_LENGTH=1000
REDIS_PARKING_TTL=86400
# Deadlines in ms. Nothing on this connection rejects by itself (BullMQ needs maxRetriesPerRequest
# null), so an unreachable broker would hang instead of failing. READY bounds the boot — the
# service logs and exits 1; COMMAND bounds an emit, so the gRPC call awaiting it gets an error.
REDIS_READY_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# cache (@backend/cache)
# Everything here is optional — the values shown are the defaults. The cache reads the REDIS_URL
# and REDIS_IP_FAMILY above and stays out of the event bus' way through its own key prefix, so a
# plain deployment needs none of these.
# Point the cache at a second Redis when this one must not be configured to evict — the event
# bus' queues are durable, cache entries are not.
CACHE_REDIS_URL=redis://localhost:6379
# `memory` is process-local (no connection at all, nothing shared between replicas, lost on
# restart): dev and tests only.
CACHE_DRIVER=redis
# First key segment. Keys read <prefix>:<namespace>:<key>, e.g. cache:auth:user:<id>.
CACHE_KEY_PREFIX=cache
# Default entry lifetime in seconds; 0 stores without an expiry. Here it is the backstop for
# writes that bypass the use-cases (migrations, manual SQL) and so evict nothing.
CACHE_TTL=300
# Budget in ms for one lookup before it is abandoned as a miss. A cache sits in front of a request,
# so a slow Redis must cost milliseconds, not the request.
CACHE_COMMAND_TIMEOUT=1000

# JWT
# Access tokens are RS256. Generate the base64-encoded PEM pair with the snippet in README.
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
# Refresh tokens stay HS256 — only this service verifies them.
REFRESH_JWT_SECRET=

# admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=string123

# temp code
TEMP_TOKEN_EXPIRES_IN_MINUTES=1
