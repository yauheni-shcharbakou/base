{
  "name": "backend.auth",
  "private": true,
  "author": "Yauheni Shcharbakou <iipekolict@gmail.com>",
  "license": "MIT",
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm start:dev",
    "prod": "pnpm start:prod",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" --config ../../../.prettierrc",
    "start": "dotenv -- nest start",
    "start:dev": "dotenv -- nest start --watch",
    "start:debug": "dotenv -- nest start --debug --watch",
    "start:prod": "mikro-orm migration:up --config dist/mikro-orm.config.js && node dist/main",
    "orm": "dotenv -- mikro-orm",
    "migrate": "pnpm orm migration:up",
    "migrate:create": "pnpm orm migration:create",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "reset": "rm -rf .turbo dist node_modules",
    "reset:modules": "rm -rf node_modules"
  },
  "dependencies": {
    "@backend/cache": "workspace:*",
    "@backend/common": "workspace:*",
    "@backend/grpc": "workspace:*",
    "@backend/event-bus": "workspace:*",
    "@backend/event-bus-redis": "workspace:*",
    "@backend/pg": "workspace:*",
    "@backend/proto": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@grpc/proto-loader": "catalog:",
    "@mikro-orm/cli": "catalog:",
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/decorators": "catalog:",
    "@mikro-orm/migrations": "catalog:",
    "@mikro-orm/nestjs": "catalog:",
    "@mikro-orm/postgresql": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@packages/common": "workspace:*",
    "@packages/proto": "workspace:*",
    "@sweet-monads/either": "catalog:",
    "bcrypt": "6.0.0",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "lodash": "catalog:",
    "moment": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@packages/configs": "workspace:*",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@types/bcrypt": "6.0.0",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/supertest": "catalog:",
    "jest": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "typescript": "catalog:"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ],
    "tsLoader": "swc"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
