{
  "name": "base",
  "private": true,
  "author": "Yauheni Shcharbakou <iipekolict@gmail.com>",
  "license": "MIT",
  "version": "3.0.2",
  "scripts": {
    "compile": "turbo run compile",
    "compile:proto": "turbo run compile --filter=\"@*/proto\"",
    "compile:event-bus": "turbo run compile --filter=\"@backend/event-bus*\"",
    "compile:env-docs": "turbo run compile --filter=@packages/env-docs",
    "check:audit": "pnpm audit --prod --audit-level=high",
    "check:env-docs": "pnpm --filter=@packages/env-docs run check",
    "check:docs": "bash scripts/docs-invariants.sh",
    "check:scripts": "bash scripts/release-notes.test.sh && bash scripts/classify-changes.test.sh && bash scripts/check-railway-exposure.test.sh && bash scripts/released-entries.test.sh && bash scripts/frozen-adrs.test.sh && bash scripts/stale-overrides.test.sh && bash scripts/audit-paths.test.sh",
    "check:railway": "tsc -p .railway/tsconfig.json",
    "dev": "turbo run dev --filter=\"backend.*\" --filter=\"frontend.*\"",
    "dev:backend": "turbo run dev --filter=\"backend.*\"",
    "dev:backend.api-gateway": "turbo run dev --filter=backend.api-gateway",
    "dev:backend.auth": "turbo run dev --filter=backend.auth",
    "dev:backend.storage": "turbo run dev --filter=backend.storage",
    "dev:frontend": "turbo run dev --filter=\"frontend.*\"",
    "dev:frontend.admin": "turbo run dev --filter=frontend.admin",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=\"backend.*\"",
    "build:backend.api-gateway": "turbo run build --filter=backend.api-gateway",
    "build:backend.auth": "turbo run build --filter=backend.auth",
    "build:backend.storage": "turbo run build --filter=backend.storage",
    "build:frontend": "turbo run build --filter=\"frontend.*\"",
    "build:frontend.admin": "turbo run build --filter=frontend.admin",
    "build:proto": "turbo run build --filter=\"@*/proto\"",
    "prod": "turbo run prod",
    "prod:backend": "turbo run prod --filter=\"backend.*\"",
    "prod:backend.api-gateway": "turbo run prod --filter=backend.api-gateway",
    "prod:backend.auth": "turbo run prod --filter=backend.auth",
    "prod:backend.storage": "turbo run prod --filter=backend.storage",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "migrate": "turbo run migrate",
    "migrate:backend.auth": "turbo run migrate --filter=backend.auth",
    "migrate:backend.storage": "turbo run migrate --filter=backend.storage",
    "migrate:check": "turbo run migrate:check",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "gen:package": "turbo gen package && pnpm install",
    "reset": "turbo run reset && rm -rf .turbo node_modules pnpm-lock.yaml",
    "reset:backend": "turbo run reset --filter=\"backend.*\"",
    "reset:frontend": "turbo run reset --filter=\"frontend.*\"",
    "reset:modules": "turbo run reset:modules && rm -rf node_modules",
    "docker:local": "docker compose -f docker-compose.yml --profile local up --build",
    "docker:local:d": "docker compose -f docker-compose.yml --profile local up --build -d",
    "docker:db": "docker compose -f docker-compose.yml up -d postgres postgres-init redis",
    "docker:db:stop": "docker compose -f docker-compose.yml stop postgres postgres-init redis",
    "docker:e2e": "docker compose -f docker-compose.yml --profile e2e up -d --wait",
    "docker:e2e:stop": "docker compose -f docker-compose.yml --profile e2e stop",
    "e2e": "pnpm docker:e2e && (E2E_REQUIRE_SERVERS=1 pnpm test:e2e; code=$?; pnpm docker:e2e:stop; exit $code)",
    "docker": "docker compose -f docker-compose.yml --profile all up --build"
  },
  "devDependencies": {
    "@turbo/gen": "2.11.7",
    "@types/node": "22.19.17",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.2",
    "minimatch": "10.2.5",
    "prettier": "catalog:",
    "railway": "3.12.0",
    "tsdown": "catalog:",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
