{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["src/**/*.ts", "package.json", "tsconfig*.json", "tsdown.config.mts"],
      "outputs": ["dist/**"]
    },
    "compile": {
      // Declared explicitly rather than left to the default (every file in the package):
      // src/** is this task's output, and as an input it would make the task invalidate itself
      // on its own result. `.proto` edits arrive instead through the hash of
      // @packages/proto#compile, which the root `compile.dependsOn: ["^compile"]` puts upstream
      // of this task.
      "inputs": ["compiler/**", "package.json", "tsconfig*.json"],
      "outputs": ["src/**"]
    }
  }
}
