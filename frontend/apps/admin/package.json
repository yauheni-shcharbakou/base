{
  "name": "frontend.admin",
  "private": true,
  "author": "Yauheni Shcharbakou <iipekolict@gmail.com>",
  "license": "MIT",
  "version": "0.0.0",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && dotenv -- cross-env NODE_OPTIONS=--max_old_space_size=4096 refine dev",
    "build": "node scripts/copy-pdfjs-assets.mjs && refine build",
    "assets:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "refine start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "refine": "refine",
    "test": "jest",
    "reset": "rm -rf .next .turbo node_modules",
    "reset:modules": "rm -rf node_modules"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@frontend/proto": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@hookform/resolvers": "5.2.2",
    "@mui/icons-material": "6.5.0",
    "@mui/lab": "6.0.1-beta.36",
    "@mui/material": "6.5.0",
    "@mui/x-data-grid": "7.29.12",
    "@packages/common": "workspace:*",
    "@packages/proto": "workspace:*",
    "@refinedev/core": "5.0.12",
    "@refinedev/kbar": "2.0.1",
    "@refinedev/mui": "7.0.1",
    "@refinedev/nextjs-router": "7.0.5",
    "@refinedev/react-hook-form": "5.0.4",
    "@sweet-monads/either": "catalog:",
    "@tanstack/react-query": "5.101.2",
    "axios": "catalog:",
    "change-case-all": "catalog:",
    "js-cookie": "3.0.8",
    "lodash": "catalog:",
    "next": "15.5.27",
    "pdfjs-dist": "catalog:",
    "player.js": "0.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "15.0.0",
    "react-hook-form": "7.89.0",
    "react-pdf": "11.0.0",
    "sharp": "catalog:",
    "tus-js-client": "4.3.1",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@packages/configs": "workspace:*",
    "@refinedev/cli": "2.16.52",
    "@refinedev/devtools": "2.0.5",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/lodash": "catalog:",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.2",
    "cross-env": "10.1.0",
    "jest": "30.3.0",
    "ts-jest": "29.4.14"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "bundler",
            "target": "ES2021",
            "rootDir": ".",
            "isolatedModules": true
          }
        }
      ]
    },
    "testEnvironment": "node"
  }
}
